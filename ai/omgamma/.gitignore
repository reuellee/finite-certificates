data/big_4_9/level_*.npz
data/canary_tmp/
data/verify_tmp/
data/big_4_8_canary/
data/*.log
data/*.err
data/extcount_*.jsonl
# ...except the (4,9) extension table, which IS tracked: it is the
# right-hand side of the mass identity and coverage_checker.py --extcount
# re-adds it up.
!data/extcount_4_9.jsonl
# The two LEGACY coverage arrays (keys+stabilizers, and the witness) total
# ~145 MB: too large for git, and no longer needed.  The COMPACT
# CERTIFICATE they were derived from -- tree_<r>_<n>.npz, ~10.4 MB: the
# root key plus, per class, its parent and the mutated basis -- IS tracked,
# together with MANIFEST.json, so coverage_checker.py can be run straight
# after cloning.  It reconstructs the keys and stabilizer orders from it.
data/coverage_*/*.npz
!data/coverage_*/tree_*.npz
data/covstate_*/
data/canary_coverage/
data/big_*.bak/
data/big_*.orig/
data/big_*.full/
data/canary_resume_tmp/
data/pure94/
paper/*.out
myverify*
*.out
