            continue
        tgt = r["target"]
        raw_split = tgt["split"]
        split = tuple(json.loads(raw_split) if isinstance(raw_split, str)
                      else raw_split)
        st = check_explicit(int(tgt["sigma_bits"]), split,
                            r["outcome"]["certificate"], table, 2, forms)
