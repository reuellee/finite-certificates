    """Exact RREF of E_support*y=0, sum(y)=1."""
    support = list(support)
    m = len(support)
    equations = []
    csc = matrix[:, support].tocsr()
    for row in range(csc.shape[0]):
        start, stop = csc.indptr[row], csc.indptr[row + 1]

