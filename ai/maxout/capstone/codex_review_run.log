    for i in range(n):
        for j in range(i + 1, n):
            r = np.cross(U[i], U[j])
            nr = np.linalg.norm(r)
            if nr < 1e-10:
                return None
            r = r / nr
            d = U @ r
            if np.any((np.abs(d) < 1e-9) & (np.arange(n) != i) & (np.arange(n) != j)):
