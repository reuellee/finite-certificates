1382-<td class="ltx_eqn_cell ltx_align_center"><math alttext="Q\,\,=\,\,\operatorname{conv}\left(\sum_{i=1}^{n}a_{i}I_{i}\,\,\cup\,\,\sum_{i=1}^{n}b_{i}I_{i}\right)\,\,\subset\,\,\mathbb{R}^{d}," class="ltx_Math" display="block" id="S6.E24.m1" intent=":literal"><semantics><mrow><mrow><mi>Q</mi><mo lspace="0.608em" rspace="0.608em">=</mo><mrow><mi>conv</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><msub><mi>a</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>I</mi><mi>i</mi></msub></mrow></mrow><mo rspace="0.385em">∪</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><msub><mi>b</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>I</mi><mi>i</mi></msub></mrow></mrow></mrow><mo rspace="0.330em">)</mo></mrow></mrow><mo rspace="0.608em">⊂</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">Q\,\,=\,\,\operatorname{conv}\left(\sum_{i=1}^{n}a_{i}I_{i}\,\,\cup\,\,\sum_{i=1}^{n}b_{i}I_{i}\right)\,\,\subset\,\,\mathbb{R}^{d},</annotation></semantics></math></td>
