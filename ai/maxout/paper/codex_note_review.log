1416:<td class="ltx_eqn_cell ltx_align_center"><math alttext="Q\,\,=\,\,\sum_{i=1}^{n}\max(a_{i}^{\prime},b_{i}^{\prime})I_{i}\,+\,\operatorname{conv}\left(\sum_{i=1}^{n}a_{i}^{\prime}I_{i}\,\cup\,\sum_{i=1}^{n}b_{i}^{\prime}I_{i}\right)\subset\mathbb{R}^{d}." class="ltx_Math" display="block" id="S6.E25.m1" intent=":literal"><semantics><mrow><mrow><mi>Q</mi><mo lspace="0.608em" rspace="0.441em">=</mo><mrow><mrow><munderover><mo movablelimits="false">âˆ‘</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><mrow><mi>max</mi><mo>â¡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mi>i</mi><mo>â€²</mo></msubsup><mo>,</mo><msubsup><mi>b</mi><mi>i</mi><mo>â€²</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">â€‹</mo><msub><mi>I</mi><mi>i</mi></msub></mrow></mrow><mo rspace="0.392em">+</mo><mrow><mi>conv</mi><mo>â¡</mo><mrow><mo>(</mo><mrow><mrow><munderover><mo lspace="0em" movablelimits="false">âˆ‘</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><msubsup><mi>a</mi><mi>i</mi><mo>â€²</mo></msubsup><mo lspace="0em" rspace="0em">â€‹</mo><msub><mi>I</mi><mi>i</mi></msub></mrow></mrow><mo>âˆª</mo><mrow><munderover><mo movablelimits="false">âˆ‘</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><msubsup><mi>b</mi><mi>i</mi><mo>â€²</mo></msubsup><mo lspace="0em" rspace="0em">â€‹</mo><msub><mi>I</mi><mi>i</mi></msub></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>âŠ‚</mo><msup><mi>â„</mi><mi>d</mi></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Q\,\,=\,\,\sum_{i=1}^{n}\max(a_{i}^{\prime},b_{i}^{\prime})I_{i}\,+\,\operatorname{conv}\left(\sum_{i=1}^{n}a_{i}^{\prime}I_{i}\,\cup\,\sum_{i=1}^{n}b_{i}^{\prime}I_{i}\right)\subset\mathbb{R}^{d}.</annotation></semantics></math></td>

