{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finite-certificates.example/diag3/component-coverage-v1.schema.json",
  "title": "9DVL diagonal-three component coverage certificate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "status",
    "base_revision",
    "scope",
    "inputs",
    "factor_dispositions",
    "boundary_tags",
    "coverage_summary",
    "semantic_sha256"
  ],
  "properties": {
    "format": {"const": "diag3-row2599-component-coverage-certificate-v1"},
    "status": {"enum": ["GLOBAL_COMPLETE", "INCOMPLETE", "LOCAL_PILOT"]},
    "base_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent_index", "support", "ambient_parameter_dimension", "candidate_factor_count"],
      "properties": {
        "parent_index": {"const": 2599},
        "support": {"const": [15, 15, 15]},
        "ambient_parameter_dimension": {"const": 9},
        "candidate_factor_count": {"const": 17824}
      }
    },
    "inputs": {
      "type": "object",
      "minProperties": 4,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "factor_dispositions": {
      "type": "array",
      "minItems": 17824,
      "maxItems": 17824,
      "items": {"$ref": "#/$defs/factorDisposition"}
    },
    "boundary_tags": {
      "type": "array",
      "items": {"$ref": "#/$defs/boundaryTag"}
    },
    "coverage_summary": {
      "type": "object",
      "required": ["empty_factors", "nonempty_factors", "unresolved_factors", "unhit_components", "open_frontiers"],
      "properties": {
        "empty_factors": {"type": "integer", "minimum": 0},
        "nonempty_factors": {"type": "integer", "minimum": 0},
        "unresolved_factors": {"type": "integer", "minimum": 0},
        "unhit_components": {"type": "integer", "minimum": 0},
        "open_frontiers": {"type": "integer", "minimum": 0}
      }
    },
    "semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "factorDisposition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["factor_id", "disposition", "empty_proof"],
          "properties": {
            "factor_id": {"type": "integer", "minimum": 0},
            "disposition": {"const": "EMPTY_STRICT_PARENT"},
            "empty_proof": {"$ref": "#/$defs/artifactRef"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["factor_id", "disposition", "roadmap_completeness", "components"],
          "properties": {
            "factor_id": {"type": "integer", "minimum": 0},
            "disposition": {"const": "NONEMPTY_COMPONENT_QUOTIENT"},
            "roadmap_completeness": {"$ref": "#/$defs/artifactRef"},
            "components": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["component_id", "piece_ids", "source_hits", "frontier_tag_ids"],
                "properties": {
                  "component_id": {"type": "string", "minLength": 1},
                  "piece_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                  "source_hits": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceHit"}},
                  "frontier_tag_ids": {"type": "array", "items": {"type": "string"}}
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["factor_id", "disposition", "missing"],
          "properties": {
            "factor_id": {"type": "integer", "minimum": 0},
            "disposition": {"const": "UNRESOLVED"},
            "missing": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "sourceHit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_index", "event_cell_id", "intersection_proof"],
      "properties": {
        "edge_index": {"type": "integer", "minimum": 0},
        "event_cell_id": {"type": "string", "minLength": 1},
        "intersection_proof": {"$ref": "#/$defs/artifactRef"}
      }
    },
    "boundaryTag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag_id", "factor_id", "piece_id", "kind", "proof"],
      "properties": {
        "tag_id": {"type": "string", "minLength": 1},
        "factor_id": {"type": "integer", "minimum": 0},
        "piece_id": {"type": "string", "minLength": 1},
        "kind": {
          "enum": [
            "INTERNAL_CONTINUATION",
            "CHART_SEAM",
            "GENUINE_RELATIVE_PARENT_FACE",
            "GENUINE_RELATIVE_PARENT_INFINITY",
            "ARTIFICIAL_SCOPE_FRONTIER",
            "UNCLASSIFIED_FRONTIER"
          ]
        },
        "mate_tag_id": {"type": "string"},
        "relative_face_id": {"type": "string"},
        "proof": {"$ref": "#/$defs/artifactRef"}
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "record_id"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "record_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
